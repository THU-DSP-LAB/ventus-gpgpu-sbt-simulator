.version 7.0
.target sm_75
.address_size 64

// 手工翻译自 testcases/simple/simple.S
// 语义：对 base 指向的 int32 数组执行 arr[tid] += tid （tid=0..31）
.visible .entry vecadd_simple(
    .param .u64 base
)
{
    .reg .b32 %r<5>;
    .reg .b64 %rd<5>;

    // base 为 device pointer（generic），转为 global 地址
    ld.param.u64 %rd1, [base];
    cvta.to.global.u64 %rd2, %rd1;

    // lane = %laneid (0..31)
    mov.u32 %r1, %laneid;

    // byte_offset = tid << 2
    shl.b32 %r2, %r1, 2;
    cvt.u64.u32 %rd3, %r2;
    add.u64 %rd4, %rd2, %rd3;

    // x = *(uint32_t*)(base + byte_offset)
    ld.global.u32 %r3, [%rd4];

    // x += tid
    add.u32 %r4, %r3, %r1;

    // store back
    st.global.u32 [%rd4], %r4;
    ret;
}
