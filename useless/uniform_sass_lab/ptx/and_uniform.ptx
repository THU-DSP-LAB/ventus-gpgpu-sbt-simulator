.version 8.1
.target sm_89
.address_size 64

// out[tid] = (a & 0xff00ff00) + 1  (a uniform)
.visible .entry k_and_uniform(
    .param .u64 p_out,
    .param .u32 p_a
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r1, [p_a];

    mov.u32 %r2, %tid.x;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;

    and.b32 %r3, %r1, 0xff00ff00;
    add.u32 %r4, %r3, 1;

    st.global.u32 [%rd3], %r4;
    ret;
}
