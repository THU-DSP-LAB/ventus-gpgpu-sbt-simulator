.version 8.1
.target sm_89
.address_size 64

// out[tid] = (a << b) ^ 0x5a5a5a5a  (a,b 均为 param => uniform)
.visible .entry k_shift_uniform(
    .param .u64 p_out,
    .param .u32 p_a,
    .param .u32 p_b
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r1, [p_a];
    ld.param.u32 %r2, [p_b];

    mov.u32 %r3, %tid.x;
    mul.wide.u32 %rd2, %r3, 4;
    add.u64 %rd3, %rd1, %rd2;

    shl.b32 %r4, %r1, %r2;
    xor.b32 %r5, %r4, 0x5a5a5a5a;

    st.global.u32 [%rd3], %r5;
    ret;
}
