.version 8.1
.target sm_89
.address_size 64

// out[tid] = (a << tid) ^ 0x5a5a5a5a  (shift amount 是 tid => 非 uniform)
.visible .entry k_shift_nonuniform(
    .param .u64 p_out,
    .param .u32 p_a
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r1, [p_a];

    mov.u32 %r2, %tid.x;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;

    shl.b32 %r4, %r1, %r2;
    xor.b32 %r5, %r4, 0x5a5a5a5a;

    st.global.u32 [%rd3], %r5;
    ret;
}
