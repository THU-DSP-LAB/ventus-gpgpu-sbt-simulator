.version 8.1
.target sm_89
.address_size 64

// 目标：触发 uniform IMAD（希望看到 UIMAD / UISETP 等）
// t = ctaid.x * 7 + n; if (t >= 1000) return;  (全是 uniform) 且使用 bra.uni
.visible .entry k_uimad_brauni(
    .param .u64 p_out,
    .param .u32 p_a,
    .param .u32 p_n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<8>;

    mov.u32 %r1, %ctaid.x;
    ld.param.u32 %r2, [p_n];

    mul.lo.u32 %r3, %r1, 7;
    add.u32 %r4, %r3, %r2;

    setp.ge.u32 %p1, %r4, 1000;
    @%p1 bra.uni DONE;

    // out[tid] = a * 13 + 5
    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r5, [p_a];

    mov.u32 %r6, %tid.x;
    mul.wide.u32 %rd2, %r6, 4;
    add.u64 %rd3, %rd1, %rd2;

    mul.lo.u32 %r7, %r5, 13;
    add.u32 %r8, %r7, 5;
    st.global.u32 [%rd3], %r8;

DONE:
    ret;
}
