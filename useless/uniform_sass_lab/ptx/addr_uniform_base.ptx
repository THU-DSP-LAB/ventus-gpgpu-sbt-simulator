.version 8.1
.target sm_89
.address_size 64

// 探索“uniform 地址基址计算”：
// base = out + (ctaid.x * ntid.x) * 4   (ctaid/ntid 是 CTA 内 uniform)
// out[block_base + tid] = a + 7
.visible .entry k_addr_uniform_base(
    .param .u64 p_out,
    .param .u32 p_a
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;

    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r1, [p_a];

    // block_base = ctaid.x * ntid.x
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mul.lo.u32 %r4, %r2, %r3;

    // uniform base address for this CTA
    mul.wide.u32 %rd2, %r4, 4;
    add.u64 %rd3, %rd1, %rd2;

    // per-thread offset within CTA
    mov.u32 %r5, %tid.x;
    mul.wide.u32 %rd4, %r5, 4;
    add.u64 %rd5, %rd3, %rd4;

    add.u32 %r6, %r1, 7;
    st.global.u32 [%rd5], %r6;
    ret;
}
