.version 8.1
.target sm_89
.address_size 64

// out[tid] = (a + tid) * 13 + 5  (引入 tid)
.visible .entry k_muladd_nonuniform(
    .param .u64 p_out,
    .param .u32 p_a
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r1, [p_a];

    mov.u32 %r2, %tid.x;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;

    add.u32 %r3, %r1, %r2;
    mul.lo.u32 %r4, %r3, 13;
    add.u32 %r5, %r4, 5;

    st.global.u32 [%rd3], %r5;
    ret;
}
