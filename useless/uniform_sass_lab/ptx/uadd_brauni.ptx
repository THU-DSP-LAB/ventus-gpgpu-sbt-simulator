.version 8.1
.target sm_89
.address_size 64

// 目标：触发 uniform ALU（希望看到 UIADD3 / UISETP 等）
// t = ctaid.x + n; if (t >= 123) return;  (全是 uniform) 且使用 bra.uni
.visible .entry k_uadd_brauni(
    .param .u64 p_out,
    .param .u32 p_a,
    .param .u32 p_n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;

    mov.u32 %r1, %ctaid.x;
    ld.param.u32 %r2, [p_n];

    add.u32 %r3, %r1, %r2;

    setp.ge.u32 %p1, %r3, 123;
    @%p1 bra.uni DONE;

    // out[tid] = a + 7
    ld.param.u64 %rd1, [p_out];
    ld.param.u32 %r4, [p_a];

    mov.u32 %r5, %tid.x;
    mul.wide.u32 %rd2, %r5, 4;
    add.u64 %rd3, %rd1, %rd2;

    add.u32 %r6, %r4, 7;
    st.global.u32 [%rd3], %r6;

DONE:
    ret;
}
