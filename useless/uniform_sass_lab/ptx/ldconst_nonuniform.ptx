.version 8.1
.target sm_89
.address_size 64

// 常量内存 + non-uniform 索引：idx = (tid.x & 3)

.const .align 4 .u32 cdata[4] = { 10, 20, 30, 40 };

.visible .entry k_ldconst_nonuniform(
    .param .u64 p_out
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;

    // idx = tid.x & 3   (non-uniform)
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 3;

    mov.u64 %rd1, cdata;
    cvta.to.const.u64 %rd1, %rd1;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;

    ld.const.u32 %r3, [%rd3];

    ld.param.u64 %rd4, [p_out];
    mul.wide.u32 %rd5, %r1, 4;
    add.u64 %rd6, %rd4, %rd5;
    st.global.u32 [%rd6], %r3;

    ret;
}
